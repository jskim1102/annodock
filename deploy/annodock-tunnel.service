[Unit]
Description=Annodock Cloudflare Tunnel
Wants=network-online.target
Requires=annodock-proxy.service
After=network-online.target annodock-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/kim_3090/dev/harness-claude/claude-project/annodock
EnvironmentFile=/home/kim_3090/dev/harness-claude/claude-project/annodock/.env
ExecStartPre=/home/kim_3090/dev/harness-claude/claude-project/annodock/deploy/render-cloudflared-config.sh
ExecStart=/home/kim_3090/.local/bin/cloudflared tunnel --config /home/kim_3090/dev/harness-claude/claude-project/annodock/.prod-runtime/cloudflared-config.yml --no-autoupdate run
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
