# add-cto writes the real port allocation to the ignored .env file.
# Keep every committed port value blank.
PORT_OFFSET=
BACKEND_PORT=
FRONTEND_PORT=
# auth-service host port (set the allocated value in the ignored .env file)
AUTH_PORT=

# Replace <password> locally. The application container uses the shared-pg DNS
# name; Alembic and dev.sh translate it to localhost:5435 on the host.
DATABASE_URL=postgresql+asyncpg://postgres:<password>@harness-shared-postgres:5432/annodock
TEST_DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5435/annodock_test

STORAGE_DIR=./storage
# Public URL used by the backend to fetch auth-service JWKS.
AUTH_BASE_URL=
CORS_ORIGINS=

# Production OAuth app credentials. Put real values only in the ignored .env.
# Compose inspection tolerates blank values, but ./dev.sh up requires all six
# so auth never starts with a partially configured provider set.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional provider scopes. Compose supplies the normal Naver/Google defaults;
# Kakao must remain blank until the requested consent scopes are approved.
NAVER_SCOPE=
KAKAO_SCOPE=
GOOGLE_SCOPE=

# Canonical production browser origin, without a trailing slash
# (for example: https://app.example.com).
PUBLIC_APP_URL=
# Loopback-only Caddy origin used by the named Cloudflare Tunnel.
PROXY_PORT=

MAX_ZIP_BYTES=21474836480
MAX_EXTRACTED_BYTES=107374182400
MAX_FILE_COUNT=200000
MAX_COMPRESSION_RATIO=100
DISK_HEADROOM_FACTOR=1.2
ALLOWED_IMAGE_EXTS=avif,bmp,dng,heic,heif,jp2,jpeg,jpeg2000,jpg,mpo,png,tif,tiff,webp

# Per-user quota and terminal training artifact retention defaults.
QUOTA_BYTES_PER_USER=107374182400
RUN_ARTIFACT_KEEP_COUNT=10
RUN_ARTIFACT_KEEP_DAYS=30
UPLOAD_GC_TTL_HOURS=24
UPLOAD_GC_RESOLUTION_TTL_DAYS=7
INGEST_BATCH_SIZE=2000
DATASET_MAX_IMAGES=5000

# admin 대시보드용 auth DB read-only 접속 URL (예: postgresql+asyncpg://user:pw@localhost:5435/auth)
AUTH_DATABASE_URL=
